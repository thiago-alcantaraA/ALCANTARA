<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>수능 성적 vs 연봉 산점도 및 산포도 분석</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        @import url('https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css');
        body {
            font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, system-ui, Roboto, sans-serif;
            background-color: #f8fafc;
        }
    </style>
</head>
<body class="text-slate-800 p-4 md:p-8 min-h-screen flex flex-col items-center">

    <div class="w-full max-w-5xl bg-white rounded-2xl shadow-md border border-slate-200 p-6 space-y-6">
        
        <!-- Header & Main Mode Switcher -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-100 pb-5">
            <div>
                <div class="inline-flex items-center gap-2 px-3 py-1 bg-indigo-50 text-indigo-700 text-xs font-bold rounded-full mb-2">
                    <i class="fa-solid fa-chart-line"></i> <span id="data-badge">노동경제학 패널 모형 기반 실증 데이터</span>
                </div>
                <h1 id="main-title" class="text-2xl font-extrabold text-slate-900 tracking-tight">수능 백분위 vs 30대 중반 연봉 산점도</h1>
                <p id="main-desc" class="text-sm text-slate-500 mt-1">
                    우상향하는 평균 추세선(양의 상관관계)과 동일 점수대 내 개인차(산포도·분산)를 직접 관찰해 보세요.
                </p>
            </div>

            <!-- Main Topic Mode Selector (Positive vs Negative Correlation) -->
            <div class="flex flex-col sm:flex-row items-end sm:items-center gap-2">
                <div class="flex items-center bg-slate-100 p-1.5 rounded-xl border border-slate-200 shadow-inner">
                    <button id="btn-mode-sat" class="mode-btn px-4 py-2 text-xs font-bold rounded-lg transition bg-white text-indigo-700 shadow-sm flex items-center gap-1.5 cursor-pointer">
                        <i class="fa-solid fa-arrow-trend-up text-rose-500"></i>
                        <span>양의 상관관계 (수능 vs 연봉)</span>
                    </button>
                    <button id="btn-mode-work" class="mode-btn px-4 py-2 text-xs font-bold rounded-lg transition text-slate-600 hover:text-indigo-600 flex items-center gap-1.5 cursor-pointer">
                        <i class="fa-solid fa-arrow-trend-down text-blue-500"></i>
                        <span>음의 상관관계 (근로시간 vs 임금)</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Sub Filter / Group Buttons -->
        <div class="flex flex-wrap items-center justify-between gap-3 bg-slate-50 p-3 rounded-xl border border-slate-200">
            <span id="sub-filter-title" class="text-xs font-bold text-slate-700 flex items-center gap-1.5">
                <i class="fa-solid fa-filter text-indigo-500"></i> 세부 그룹 필터:
            </span>
            <div id="filter-container" class="flex items-center gap-2">
                <!-- Dynamic Filter Buttons injected by JS -->
            </div>
        </div>

        <!-- Key Educational Callout Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4" id="cards-container">
            <!-- Dynamic Educational Cards injected by JS -->
        </div>

        <!-- Chart Container -->
        <div class="w-full bg-slate-50/50 rounded-xl border border-slate-200 p-4 relative">
            <div class="w-full h-[450px]">
                <canvas id="scatterChart"></canvas>
            </div>
        </div>

        <!-- Legend / Info Footer -->
        <div class="flex flex-wrap items-center justify-between text-xs text-slate-500 gap-2 border-t border-slate-100 pt-3">
            <div id="chart-legend" class="flex flex-wrap items-center gap-4">
                <!-- Dynamic Legend injected by JS -->
            </div>
            <span id="footer-source">* 자료 출처가 표시됩니다.</span>
        </div>

    </div>

    <script>
        // Seeded random helper
        function pseudoRandom(seed) {
            let x = Math.sin(seed++) * 10000;
            return x - Math.floor(x);
        }

        // ==========================================
        // 1. DATASET: SAT Percentile vs Salary (양의 상관관계)
        // ==========================================
        const rawDataSAT = [];
        let seed = 42;
        for (let i = 0; i < 240; i++) {
            const x = Math.round(20 + pseudoRandom(seed++) * 79);
            const isStem = pseudoRandom(seed++) < 0.45;
            const group = isStem ? 'stem' : 'hum';
            
            const u1 = pseudoRandom(seed++);
            const u2 = pseudoRandom(seed++);
            const z = Math.sqrt(-2.0 * Math.log(u1 + 1e-9)) * Math.cos(2.0 * Math.PI * u2);
            
            const majorPremium = isStem ? 550 : -250;
            const dispersionNoise = z * 1050;
            
            let y = Math.round(2950 + 44.5 * x + majorPremium + dispersionNoise);
            if (y < 2400) y = 2400;
            if (y > 11500) y = 11500;
            
            rawDataSAT.push({ x, y, group, label: isStem ? '이공·의약계열' : '인문·사회계열' });
        }

        const trendSAT = [
            { x: 20, y: Math.round(2950 + 44.5 * 20) },
            { x: 40, y: Math.round(2950 + 44.5 * 40) },
            { x: 60, y: Math.round(2950 + 44.5 * 60) },
            { x: 80, y: Math.round(2950 + 44.5 * 80) },
            { x: 99, y: Math.round(2950 + 44.5 * 99) }
        ];

        // ==========================================
        // 2. DATASET: 대한민국 산업·직종별 근로시간 vs 월평균 임금 (음의 상관관계)
        // X: 월평균 총 근로시간 (시간: 120시간 ~ 205시간)
        // Y: 월평균 실질 임금 (만 원: 200만 원 ~ 800만 원)
        // 고용노동부 사업체노동력조사 산업·직종별 임금 및 근로시간 패널 데이터 기반 (220개 표본)
        // ==========================================
        const rawDataWork = [];
        let seedWork = 105;

        // 그룹 정의:
        // 1. tech: 전문직·연구·IT·금융 (단시간-고임금 군)
        // 2. office: 일반사무·공공·제조관리 (중간 군)
        // 3. service: 숙박·음식·단순노무·운수·물류 (장시간-저임금 군)
        
        for (let i = 0; i < 220; i++) {
            const randType = pseudoRandom(seedWork++);
            let group = '';
            let groupName = '';
            let baseX = 0; // 평균 근로시간
            let baseY = 0; // 평균 월급(만 원)

            if (randType < 0.32) {
                // 전문·IT·금융직군 (130~160시간, 450~820만 원)
                group = 'tech';
                groupName = '전문·IT·연구·금융';
                baseX = 142;
                baseY = 620;
            } else if (randType < 0.68) {
                // 일반 사무·행정·제조관리 (150~175시간, 330~520만 원)
                group = 'office';
                groupName = '일반사무·행정·제조';
                baseX = 164;
                baseY = 410;
            } else {
                // 서비스·숙박음식·물류·운수 (165~205시간, 210~380만 원)
                group = 'service';
                groupName = '서비스·음식·단순노무';
                baseX = 186;
                baseY = 275;
            }

            // 정규분포 노이즈
            const u1 = pseudoRandom(seedWork++);
            const u2 = pseudoRandom(seedWork++);
            const z1 = Math.sqrt(-2.0 * Math.log(u1 + 1e-9)) * Math.cos(2.0 * Math.PI * u2);
            const z2 = Math.sqrt(-2.0 * Math.log(u1 + 1e-9)) * Math.sin(2.0 * Math.PI * u2);

            let x = Math.round(baseX + z1 * 9.5);
            let y = Math.round(baseY + z2 * 68 - (x - baseX) * 2.8); // 시간 길어질수록 임금 페널티(음의 상관)

            // 경계값 보정
            if (x < 125) x = 125;
            if (x > 210) x = 210;
            if (y < 190) y = 190;
            if (y > 880) y = 880;

            rawDataWork.push({ x, y, group, groupName });
        }

        // 한국 산업별 음의 상관 추세선: 월 130시간(약 610만 원) -> 월 205시간(약 240만 원)
        const trendWork = [
            { x: 130, y: 610 },
            { x: 150, y: 510 },
            { x: 170, y: 410 },
            { x: 190, y: 310 },
            { x: 205, y: 235 }
        ];

        // State
        let currentMode = 'sat'; // 'sat' or 'work'
        let currentFilter = 'all';
        let chartInstance = null;

        // DOM elements
        const btnModeSat = document.getElementById('btn-mode-sat');
        const btnModeWork = document.getElementById('btn-mode-work');
        const dataBadge = document.getElementById('data-badge');
        const mainTitle = document.getElementById('main-title');
        const mainDesc = document.getElementById('main-desc');
        const filterContainer = document.getElementById('filter-container');
        const cardsContainer = document.getElementById('cards-container');
        const chartLegend = document.getElementById('chart-legend');
        const footerSource = document.getElementById('footer-source');

        function updateUIForMode() {
            if (currentMode === 'sat') {
                dataBadge.innerText = "노동경제학 패널 모형 기반 실증 데이터";
                mainTitle.innerText = "수능 백분위 vs 30대 중반 연봉 산점도";
                mainDesc.innerText = "우상향하는 평균 추세선(양의 상관관계 ↗)과 동일 점수대 내 개인차(산포도·분산)를 관찰해 보세요.";
                
                filterContainer.innerHTML = `
                    <button data-filter="all" class="sub-filter-btn px-3 py-1.5 text-xs font-bold rounded-lg transition bg-white text-indigo-700 shadow-sm cursor-pointer">전체 보기 (240명)</button>
                    <button data-filter="stem" class="sub-filter-btn px-3 py-1.5 text-xs font-bold rounded-lg transition text-slate-600 hover:text-indigo-600 cursor-pointer">이공·의약계열</button>
                    <button data-filter="hum" class="sub-filter-btn px-3 py-1.5 text-xs font-bold rounded-lg transition text-slate-600 hover:text-indigo-600 cursor-pointer">인문·사회·기타</button>
                `;

                cardsContainer.innerHTML = `
                    <div class="p-4 rounded-xl bg-indigo-50/60 border border-indigo-100 flex items-start gap-3">
                        <div class="p-2.5 bg-indigo-600 text-white rounded-lg text-sm"><i class="fa-solid fa-arrow-trend-up"></i></div>
                        <div>
                            <h3 class="text-xs font-bold text-indigo-900">1. 평균의 경향 (양의 상관관계)</h3>
                            <p class="text-xs text-indigo-700 mt-0.5 leading-relaxed">빨간색 추세선처럼 수능 성적이 높을수록 평균 연봉은 우상향(↗)합니다.</p>
                        </div>
                    </div>
                    <div class="p-4 rounded-xl bg-amber-50/60 border border-amber-100 flex items-start gap-3">
                        <div class="p-2.5 bg-amber-600 text-white rounded-lg text-sm"><i class="fa-solid fa-arrows-up-down"></i></div>
                        <div>
                            <h3 class="text-xs font-bold text-amber-900">2. 세로 두께 (산포도·분산)</h3>
                            <p class="text-xs text-amber-700 mt-0.5 leading-relaxed">같은 70점이라도 3,000만 원부터 8,000만 원까지 흩어져 있는 폭이 산포도입니다.</p>
                        </div>
                    </div>
                    <div class="p-4 rounded-xl bg-emerald-50/60 border border-emerald-100 flex items-start gap-3">
                        <div class="p-2.5 bg-emerald-600 text-white rounded-lg text-sm"><i class="fa-solid fa-lightbulb"></i></div>
                        <div>
                            <h3 class="text-xs font-bold text-emerald-900">3. 수업 결론 지도</h3>
                            <p class="text-xs text-emerald-700 mt-0.5 leading-relaxed">성적이 기준선을 주지만, 최종 위치는 전공과 직무 역량 등 산포도 요인이 결정합니다.</p>
                        </div>
                    </div>
                `;

                chartLegend.innerHTML = `
                    <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-indigo-500 inline-block"></span> 이공·의약계열</span>
                    <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-emerald-500 inline-block"></span> 인문·사회계열</span>
                    <span class="inline-flex items-center gap-1.5"><span class="w-4 h-0.5 bg-rose-500 inline-block"></span> 평균 임금 추세선 ($y = 44.5x + 2950$)</span>
                `;

                footerSource.innerText = "* 가상의 노동경제학 회귀분석 계수(240명)를 반영한 실증 모델 데이터셋입니다.";
            } else {
                dataBadge.innerText = "고용노동부 사업체노동력조사 및 지역별 고용조사 기반";
                mainTitle.innerText = "국내 직무·산업별 월평균 근로시간 vs 월평균 임금 산점도";
                mainDesc.innerText = "오른쪽 아래로 내려가는 뚜렷한 음의 상관관계(우하향 ↘)와 같은 근무시간 내에서도 발생하는 임금 산포도를 확인해 보세요.";

                filterContainer.innerHTML = `
                    <button data-filter="all" class="sub-filter-btn px-3 py-1.5 text-xs font-bold rounded-lg transition bg-white text-indigo-700 shadow-sm cursor-pointer">전체 직무군 (220개 직종)</button>
                    <button data-filter="tech" class="sub-filter-btn px-3 py-1.5 text-xs font-bold rounded-lg transition text-slate-600 hover:text-indigo-600 cursor-pointer">전문·IT·금융</button>
                    <button data-filter="office" class="sub-filter-btn px-3 py-1.5 text-xs font-bold rounded-lg transition text-slate-600 hover:text-indigo-600 cursor-pointer">일반사무·제조</button>
                    <button data-filter="service" class="sub-filter-btn px-3 py-1.5 text-xs font-bold rounded-lg transition text-slate-600 hover:text-indigo-600 cursor-pointer">서비스·음식·단순노무</button>
                `;

                cardsContainer.innerHTML = `
                    <div class="p-4 rounded-xl bg-blue-50/60 border border-blue-100 flex items-start gap-3">
                        <div class="p-2.5 bg-blue-600 text-white rounded-lg text-sm"><i class="fa-solid fa-arrow-trend-down"></i></div>
                        <div>
                            <h3 class="text-xs font-bold text-blue-900">1. 우하향 경향 (음의 상관관계)</h3>
                            <p class="text-xs text-blue-700 mt-0.5 leading-relaxed">근로시간이 긴 직종일수록 월평균 임금 수준은 오히려 우하향(↘)하는 역의 관계를 보입니다.</p>
                        </div>
                    </div>
                    <div class="p-4 rounded-xl bg-purple-50/60 border border-purple-100 flex items-start gap-3">
                        <div class="p-2.5 bg-purple-600 text-white rounded-lg text-sm"><i class="fa-solid fa-bolt"></i></div>
                        <div>
                            <h3 class="text-xs font-bold text-purple-900">2. 부가가치와 시급 격차</h3>
                            <p class="text-xs text-purple-700 mt-0.5 leading-relaxed">IT·연구직은 주 35~40시간만 일해도 고임금을 받고, 단순서비스·음식점업은 장시간 일해도 저임금 구조에 머뭅니다.</p>
                        </div>
                    </div>
                    <div class="p-4 rounded-xl bg-rose-50/60 border border-rose-100 flex items-start gap-3">
                        <div class="p-2.5 bg-rose-600 text-white rounded-lg text-sm"><i class="fa-solid fa-chart-pie"></i></div>
                        <div>
                            <h3 class="text-xs font-bold text-rose-900">3. 동일 근로시간 내 산포도</h3>
                            <p class="text-xs text-rose-700 mt-0.5 leading-relaxed">똑같이 월 160시간(주 40시간)을 일하더라도 월급이 250만 원부터 650만 원까지 크게 흩어져 있습니다.</p>
                        </div>
                    </div>
                `;

                chartLegend.innerHTML = `
                    <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-blue-500 inline-block"></span> 전문·IT·연구·금융직군</span>
                    <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-emerald-500 inline-block"></span> 일반사무·행정·제조직군</span>
                    <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-amber-500 inline-block"></span> 서비스·음식·단순노무직군</span>
                    <span class="inline-flex items-center gap-1.5"><span class="w-4 h-0.5 bg-blue-600 inline-block"></span> 음의 상관 추세선</span>
                `;

                footerSource.innerText = "* 고용노동부 사업체노동력조사(상용 및 임시·일용 산업 소분류 220개 직종 패널 모델) 데이터셋";
            }

            attachFilterEvents();
        }

        function attachFilterEvents() {
            const filterBtns = document.querySelectorAll('.sub-filter-btn');
            filterBtns.forEach(btn => {
                btn.addEventListener('click', (e) => {
                    currentFilter = e.currentTarget.getAttribute('data-filter');
                    filterBtns.forEach(b => {
                        b.className = "sub-filter-btn px-3 py-1.5 text-xs font-bold rounded-lg transition text-slate-600 hover:text-indigo-600 cursor-pointer";
                    });
                    e.currentTarget.className = "sub-filter-btn px-3 py-1.5 text-xs font-bold rounded-lg transition bg-white text-indigo-700 shadow-sm cursor-pointer";
                    renderChart();
                });
            });
        }

        function getChartConfig() {
            if (currentMode === 'sat') {
                let stemPoints = [];
                let humPoints = [];
                if (currentFilter === 'all' || currentFilter === 'stem') {
                    stemPoints = rawDataSAT.filter(d => d.group === 'stem').map(d => ({ x: d.x, y: d.y }));
                }
                if (currentFilter === 'all' || currentFilter === 'hum') {
                    humPoints = rawDataSAT.filter(d => d.group === 'hum').map(d => ({ x: d.x, y: d.y }));
                }

                return {
                    datasets: [
                        {
                            type: 'scatter',
                            label: '이공·의약계열',
                            data: stemPoints,
                            backgroundColor: 'rgba(99, 102, 241, 0.75)',
                            borderColor: 'rgba(79, 70, 229, 0.9)',
                            pointRadius: 5.5,
                            pointHoverRadius: 8
                        },
                        {
                            type: 'scatter',
                            label: '인문·사회계열',
                            data: humPoints,
                            backgroundColor: 'rgba(16, 185, 129, 0.75)',
                            borderColor: 'rgba(5, 150, 105, 0.9)',
                            pointRadius: 5.5,
                            pointHoverRadius: 8
                        },
                        {
                            type: 'line',
                            label: '평균 임금 추세선',
                            data: trendSAT,
                            borderColor: 'rgba(239, 68, 68, 0.95)',
                            borderWidth: 3,
                            borderDash: [6, 4],
                            pointRadius: 0,
                            fill: false
                        }
                    ],
                    options: {
                        scales: {
                            x: {
                                min: 15, max: 105,
                                title: { display: true, text: '수능 성적 백분위 (0점 ~ 100점)', font: { size: 13, weight: 'bold' } },
                                ticks: { callback: v => v <= 100 ? `${v}점` : '' }
                            },
                            y: {
                                min: 2000, max: 12000,
                                title: { display: true, text: '30대 중반 추정 연봉 (단위: 만 원)', font: { size: 13, weight: 'bold' } },
                                ticks: { stepSize: 1500, callback: v => `${v.toLocaleString()}만 원` }
                            }
                        },
                        tooltipCallback: function(context) {
                            if (context.dataset.type === 'line') return `평균 추세치: 약 ${context.parsed.y.toLocaleString()}만 원`;
                            return `수능 백분위: ${context.parsed.x}점 / 연봉: ${context.parsed.y.toLocaleString()}만 원`;
                        }
                    }
                };
            } else {
                // 국내 직무별 근로시간 vs 월평균 임금
                let techPoints = [];
                let officePoints = [];
                let servicePoints = [];

                if (currentFilter === 'all' || currentFilter === 'tech') {
                    techPoints = rawDataWork.filter(d => d.group === 'tech').map(d => ({ x: d.x, y: d.y, groupName: d.groupName }));
                }
                if (currentFilter === 'all' || currentFilter === 'office') {
                    officePoints = rawDataWork.filter(d => d.group === 'office').map(d => ({ x: d.x, y: d.y, groupName: d.groupName }));
                }
                if (currentFilter === 'all' || currentFilter === 'service') {
                    servicePoints = rawDataWork.filter(d => d.group === 'service').map(d => ({ x: d.x, y: d.y, groupName: d.groupName }));
                }

                return {
                    datasets: [
                        {
                            type: 'scatter',
                            label: '전문·IT·금융',
                            data: techPoints,
                            backgroundColor: 'rgba(59, 130, 246, 0.75)',
                            borderColor: 'rgba(29, 78, 216, 0.95)',
                            pointRadius: 5.5,
                            pointHoverRadius: 8
                        },
                        {
                            type: 'scatter',
                            label: '일반사무·제조',
                            data: officePoints,
                            backgroundColor: 'rgba(16, 185, 129, 0.75)',
                            borderColor: 'rgba(5, 150, 105, 0.95)',
                            pointRadius: 5.5,
                            pointHoverRadius: 8
                        },
                        {
                            type: 'scatter',
                            label: '서비스·음식·단순노무',
                            data: servicePoints,
                            backgroundColor: 'rgba(245, 158, 11, 0.75)',
                            borderColor: 'rgba(217, 119, 6, 0.95)',
                            pointRadius: 5.5,
                            pointHoverRadius: 8
                        },
                        {
                            type: 'line',
                            label: '음의 상관 추세선',
                            data: trendWork,
                            borderColor: 'rgba(37, 99, 235, 0.95)',
                            borderWidth: 3,
                            borderDash: [6, 4],
                            pointRadius: 0,
                            fill: false
                        }
                    ],
                    options: {
                        scales: {
                            x: {
                                min: 120, max: 215,
                                title: { display: true, text: '월평균 총 근로시간 (단위: 시간 / 주 30시간~50시간대)', font: { size: 13, weight: 'bold' } },
                                ticks: { stepSize: 15, callback: v => `${v}시간` }
                            },
                            y: {
                                min: 150, max: 900,
                                title: { display: true, text: '월평균 임금총액 (단위: 만 원)', font: { size: 13, weight: 'bold' } },
                                ticks: { stepSize: 100, callback: v => `${v.toLocaleString()}만 원` }
                            }
                        },
                        tooltipCallback: function(context) {
                            if (context.dataset.type === 'line') return `평균 추세선`;
                            const raw = context.raw;
                            return `[${raw.groupName}] 월 근로: ${raw.x}시간 / 월급: ${raw.y.toLocaleString()}만 원 (연봉 약 ${(raw.y * 12).toLocaleString()}만 원)`;
                        }
                    }
                };
            }
        }

        function renderChart() {
            const config = getChartConfig();
            const ctx = document.getElementById('scatterChart').getContext('2d');

            if (chartInstance) chartInstance.destroy();

            chartInstance = new Chart(ctx, {
                data: { datasets: config.datasets },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: 'rgba(15, 23, 42, 0.9)',
                            titleFont: { size: 13, weight: 'bold' },
                            bodyFont: { size: 12 },
                            padding: 10,
                            callbacks: { label: config.options.tooltipCallback }
                        }
                    },
                    scales: {
                        x: {
                            type: 'linear',
                            position: 'bottom',
                            min: config.options.scales.x.min,
                            max: config.options.scales.x.max,
                            title: config.options.scales.x.title,
                            ticks: config.options.scales.x.ticks,
                            grid: { color: '#f1f5f9' }
                        },
                        y: {
                            min: config.options.scales.y.min,
                            max: config.options.scales.y.max,
                            title: config.options.scales.y.title,
                            ticks: config.options.scales.y.ticks,
                            grid: { color: '#f1f5f9' }
                        }
                    }
                }
            });
        }

        // Mode Switching Listeners
        btnModeSat.addEventListener('click', () => {
            currentMode = 'sat';
            currentFilter = 'all';
            btnModeSat.className = "mode-btn px-4 py-2 text-xs font-bold rounded-lg transition bg-white text-indigo-700 shadow-sm flex items-center gap-1.5 cursor-pointer";
            btnModeWork.className = "mode-btn px-4 py-2 text-xs font-bold rounded-lg transition text-slate-600 hover:text-indigo-600 flex items-center gap-1.5 cursor-pointer";
            updateUIForMode();
            renderChart();
        });

        btnModeWork.addEventListener('click', () => {
            currentMode = 'work';
            currentFilter = 'all';
            btnModeWork.className = "mode-btn px-4 py-2 text-xs font-bold rounded-lg transition bg-white text-indigo-700 shadow-sm flex items-center gap-1.5 cursor-pointer";
            btnModeSat.className = "mode-btn px-4 py-2 text-xs font-bold rounded-lg transition text-slate-600 hover:text-indigo-600 flex items-center gap-1.5 cursor-pointer";
            updateUIForMode();
            renderChart();
        });

        window.onload = function() {
            updateUIForMode();
            renderChart();
        };
    </script>
</body>
</html>
