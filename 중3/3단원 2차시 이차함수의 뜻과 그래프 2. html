<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>중3 수학 판서 - 그래프의 변형과 성질</title>
    <!-- KaTeX 라이브러리 로드 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.0/dist/katex.min.css">
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.0/dist/katex.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.0/dist/contrib/auto-render.min.js"></script>
    <!-- Tailwind CSS 로드 -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- 구글 폰트 (손글씨 및 고딕) -->
    <link href="https://fonts.googleapis.com/css2?family=Nanum+Pen+Script&family=Noto+Sans+KR:wght@400;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --chalkboard-bg: #1e3d33; 
            --chalk-white: rgba(255, 255, 255, 0.95);
            --chalk-yellow: #fdf08a;
            --chalk-blue: #a5f3fc;
            --chalk-pink: #fca5a5;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        
        html, body {
            background-color: #121212;
            font-family: 'Noto Sans KR', sans-serif;
            color: var(--chalk-white);
            width: 100vw;
            height: 100vh;
            overflow: hidden; 
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .chalkboard-outer {
            width: 100%;
            height: 100%;
            background: #3d2b1f; /* 나무 프레임 */
            padding: 0.6vh; 
            display: flex;
        }

        .chalkboard-inner {
            flex: 1;
            background-color: var(--chalkboard-bg);
            background-image: url('https://www.transparenttextures.com/patterns/black-chalkboard.png');
            position: relative;
            box-shadow: inset 0 0 150px rgba(0,0,0,0.9);
            display: flex;
            flex-direction: column;
            padding: 3vh 3vw;
            border-radius: 4px;
        }

        .handwritten { font-family: 'Nanum Pen Script', cursive; }
        .highlight-yellow { color: var(--chalk-yellow); }
        .highlight-blue { color: var(--chalk-blue); }
        .highlight-pink { color: var(--chalk-pink); }

        /* 좌우 2열 판서 레이아웃 */
        .main-grid {
            height: 100%;
            display: grid;
            grid-template-columns: 48% 52%; 
            position: relative;
            gap: 4vw;
        }

        /* 중앙 세로 점선 */
        .grid-line-v {
            position: absolute;
            left: 48%; top: 0; bottom: 0;
            width: 1px;
            border-right: 1px dashed rgba(255,255,255,0.15);
            z-index: 1;
        }

        .pane {
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            overflow-y: auto;
        }

        /* 스크롤바 커스텀 */
        .pane::-webkit-scrollbar {
            width: 4px;
        }
        .pane::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 2px;
        }

        .graph-container {
            position: relative;
            height: 35vh;
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-top: auto;
        }

        .katex { font-size: 1.05em !important; }

        /* 모바일 대응 반응형 디자인 */
        @media (max-width: 768px) {
            html, body { overflow-y: auto; height: auto; }
            .chalkboard-outer { height: auto; min-height: 100vh; padding: 10px; }
            .chalkboard-inner { padding: 20px; }
            .main-grid { grid-template-columns: 1fr; gap: 40px; }
            .grid-line-v { display: none; }
            .graph-container { height: 280px; }
        }
    </style>
</head>
<body>
    <div class="chalkboard-outer">
        <div class="chalkboard-inner">
            <div class="main-grid">
                <div class="grid-line-v"></div>

                <!-- 왼쪽 단: y = ax 그래프의 변형 -->
                <div class="pane handwritten text-[3.4vh] space-y-8 pt-4">
                    <!-- 기본형과 대응점 -->
                    <div class="space-y-2 pl-4">
                        <p class="text-[3.8vh]">
                            \(y = x\) <span class="text-[2.8vh] opacity-70 ml-4">\((0,0), \ (1,1)\)</span>
                        </p>
                        <!-- 매핑 화살표 -->
                        <div class="flex pl-16">
                            <svg width="24" height="40" viewBox="0 0 24 40">
                                <line x1="12" y1="0" x2="12" y2="35" stroke="var(--chalk-white)" stroke-width="2" />
                                <path d="M 7 30 L 12 37 L 17 30" fill="none" stroke="var(--chalk-white)" stroke-width="2" />
                            </svg>
                        </div>
                        <p class="text-[3.8vh] highlight-yellow">
                            \(y = ax\) <span class="text-[2.8vh] opacity-70 ml-4">\((0,0), \ (1,a)\)</span>
                        </p>
                    </div>

                    <!-- 일차함수 그래프의 변형 법칙 -->
                    <div class="space-y-4 pl-4 pt-4 border-t border-white/10">
                        <p class="text-[4vh] font-bold highlight-blue">\(y = x\)의 그래프의 변형</p>
                        <div class="pl-4 space-y-4 text-[3.2vh] leading-relaxed">
                            <p>
                                1) <span class="highlight-pink">\(|a| \uparrow\)</span> 
                                <span class="mx-3 text-[2.8vh] opacity-80">→</span> 
                                \(y\)축과 가까워진다.
                            </p>
                            <p>
                                2) <span class="highlight-pink">\(|a| \downarrow\)</span> 
                                <span class="mx-3 text-[2.8vh] opacity-80">→</span> 
                                \(x\)축과 가까워진다.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- 오른쪽 단: y = ax² 그래프의 변형과 기하학적 성질 -->
                <div class="pane handwritten text-[3.4vh] space-y-6 pt-4">
                    <!-- 기본형과 대응점 -->
                    <div class="space-y-4 pl-4">
                        <p class="text-[3.8vh]">
                            \(y = x^2\) <span class="text-[2.8vh] opacity-70 ml-4">\((0,0), \ (-1,1), \ (1,1)\)</span>
                        </p>
                        <p class="text-[3.8vh] highlight-yellow">
                            \(y = ax^2\) <span class="text-[2.8vh] opacity-70 ml-4">\((0,0), \ (-1,a), \ (1,a)\)</span>
                        </p>
                    </div>

                    <!-- 이차함수 그래프의 변형 법칙 -->
                    <div class="space-y-4 pl-4 pt-4 border-t border-white/10">
                        <p class="text-[4vh] font-bold highlight-blue">\(y = x^2\)의 그래프의 변형</p>
                        <div class="pl-4 space-y-4 text-[3.2vh] leading-relaxed">
                            <p>
                                1) <span class="highlight-pink">\(|a| \uparrow\)</span> 
                                <span class="mx-3 text-[2.8vh] opacity-80">→</span> 
                                그래프의 폭이 좁아진다.
                            </p>
                            <p>
                                2) <span class="highlight-pink">\(|a| \downarrow\)</span> 
                                <span class="mx-3 text-[2.8vh] opacity-80">→</span> 
                                그래프의 폭이 넓어진다.
                            </p>
                        </div>
                    </div>

                    <!-- 포물선 대칭성 증명 기하학 그래프 -->
                    <div class="graph-container">
                        <svg viewBox="0 0 400 240" width="100%" height="100%">
                            <!-- 세로 대칭축 (축) -->
                            <line x1="200" y1="20" x2="200" y2="220" stroke="var(--chalk-white)" stroke-width="1.5" />
                            <text x="215" y="35" fill="var(--chalk-white)" font-size="22" font-family="'Nanum Pen Script', cursive">축</text>

                            <!-- 좌우 대칭 포물선 -->
                            <path d="M 90,40 Q 200,240 310,40" fill="none" stroke="var(--chalk-pink)" stroke-width="2.5" />
                            <text x="320" y="45" fill="var(--chalk-pink)" font-size="22" font-family="'Nanum Pen Script', cursive">포물선</text>

                            <!-- 대칭 가로선 -->
                            <line x1="120" y1="120" x2="280" y2="120" stroke="var(--chalk-blue)" stroke-width="1.5" />
                            
                            <!-- 직각 표시 -->
                            <path d="M 200,110 L 210,110 L 210,120" fill="none" stroke="var(--chalk-blue)" stroke-width="1" />

                            <!-- 대칭 등간격 기호 (||) -->
                            <!-- 왼쪽 구간 (||) -->
                            <line x1="156" y1="112" x2="156" y2="128" stroke="var(--chalk-white)" stroke-width="1.5" />
                            <line x1="161" y1="112" x2="161" y2="128" stroke="var(--chalk-white)" stroke-width="1.5" />
                            <!-- 오른쪽 구간 (||) -->
                            <line x1="239" y1="112" x2="239" y2="128" stroke="var(--chalk-white)" stroke-width="1.5" />
                            <line x1="244" y1="112" x2="244" y2="128" stroke="var(--chalk-white)" stroke-width="1.5" />

                            <!-- 꼭짓점 표시 -->
                            <circle cx="200" cy="200" r="4.5" fill="var(--chalk-yellow)" />
                            <text x="215" y="215" fill="var(--chalk-yellow)" font-size="22" font-family="'Nanum Pen Script', cursive">꼭짓점</text>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // 수식 수동 렌더링 구동
            renderMathInElement(document.body, {
                delimiters: [
                    {left: "$$", right: "$$", display: true},
                    {left: "\\(", right: "\\)", display: false},
                    {left: "$", right: "$", display: false}
                ],
                throwOnError : false
            });
        });
    </script>
</body>
</html>
